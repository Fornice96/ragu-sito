// Cloudflare Workers (static assets): the whole folder is the site.
// not_found_handling serves 404.html for unknown paths; .assetsignore keeps
// repo-only files (git, notes, this config) off the public site.
// The site lives only on raguitalianbistro.co.uk (custom domain set in the
// Cloudflare dashboard, so no "routes" here): workers_dev/preview_urls false
// switch off the old ragu-sito.fornice.workers.dev copy and its preview URLs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ragu-sito",
  "account_id": "0c3515cb438817285d8e41e46e6802b3",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
